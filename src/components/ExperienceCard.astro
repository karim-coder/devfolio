---
interface Props {
  experience: {
    id?: string;
    title: string;
    period?: string;
    bullets?: string[];
    current?: boolean;
    tags?: string[];
  };
}
const { experience } = Astro.props as Props;
---

<article
  class="group relative pl-12 pb-8 last:pb-0"
  aria-label={`Experience: ${experience.title}`}
>
  <!-- Modern Timeline with Solid Line -->
  <div
    class=`absolute left-2 ${experience.current ? "top-2" : "top-0"}  bottom-0 w-0.5 opacity-30 dark:opacity-40`
    style="background: var(--color-timeline);"
    role="presentation"
  >
  </div>

  <!-- Elegant Branch Connector -->
  <div
    class="absolute left-2 top-2 w-12 h-12 pointer-events-none opacity-30 dark:opacity-40"
    role="presentation"
  >
    <svg
      viewBox="0 0 48 48"
      class="w-full h-full"
      fill="none"
      stroke="var( --color-timeline)"
      stroke-width="2"
    >
      <path d="M 2 2 Q 2 24 24 24 L 48 24" stroke-linecap="round"></path>
    </svg>
  </div>

  <!-- Timeline Marker -->
  <div
    class={`absolute left-2 top-2 w-3 h-3 -ml-1.5 rounded-full z-10 transition-all duration-300 ${
      experience.current ? "border-[3px]" : "border-[3px]"
    }`}
    style={experience.current
      ? "background: var(--accent); border-color: var(--color-bg); box-shadow: 0 0 0 2px var( --color-timeline);"
      : "background: var(--color-bg); border-color: var(--color-bg); box-shadow: 0 0 0 2px var( --color-timeline);"}
    role="presentation"
  >
  </div>

  <!-- Card Content with Elegant Shadow -->
  <div
    class="surface-card-sm group-hover:shadow-lg transition-all duration-300 overflow-hidden"
  >
    <!-- Header with Gradient Accent -->
    <div class="relative">
      {
        experience.current && (
          <div class="absolute -top-2 -right-2">
            <div class="relative">
              <div
                class="absolute inset-0 blur-md opacity-40"
                style="background: var(--accent);"
              />
              <div
                class="relative px-3 py-1.5 rounded-full shadow-lg"
                style="background: var(--accent); border: 1px solid var(--color-border-strong);"
              >
                <span
                  class="text-[10px] font-bold tracking-widest uppercase flex items-center gap-1.5"
                  style="color: var(--color-bg);"
                >
                  <span
                    class="w-1.5 h-1.5 rounded-full animate-pulse"
                    style="background: var(--color-bg);"
                  />
                  Current
                </span>
              </div>
            </div>
          </div>
        )
      }
      <div class="pr-24">
        <h3
          class="text-xl font-bold font-display text-primary mb-1 leading-tight transition-colors"
        >
          {experience.title}
        </h3>

        {
          experience.period && (
            <time
              class="inline-flex items-center gap-1.5 text-sm font-medium text-quaternary mb-3"
              datetime={experience.period}
            >
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                />
              </svg>
              {experience.period}
            </time>
          )
        }
      </div>
    </div>

    <!-- Elegant Divider -->
    {
      experience.bullets && experience.bullets.length > 0 && (
        <div
          class="h-px my-3"
          style="background: linear-gradient(to right, var(--color-border-strong) 0%, transparent 50%);"
        />
      )
    }

    <!-- Bullets with Enhanced Styling -->
    {
      experience.bullets && experience.bullets.length > 0 && (
        <ul class="space-y-2 mb-4">
          {experience.bullets.map((bullet, index) => (
            <li class="flex items-start gap-2.5 group/item">
              <span
                class="flex-shrink-0 w-1.5 h-1.5 rounded-full mt-1.5 transition-all"
                style="background: linear-gradient(to bottom right, var(--color-text-tertiary), var(--color-text-quaternary));"
                aria-hidden="true"
              />
              <span class="text-secondary text-sm leading-relaxed flex-1">
                {bullet}
              </span>
            </li>
          ))}
        </ul>
      )
    }

    <!-- Tags with Modern Styling -->
    {
      experience.tags && experience.tags.length > 0 && (
        <div class="relative">
          <div
            class="h-px my-3"
            style="background: linear-gradient(to right, var(--color-border-strong) 0%, transparent 50%);"
          />

          <div class="flex items-center gap-1.5 mb-2">
            <svg
              class="w-3.5 h-3.5 text-quaternary"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
              />
            </svg>
            <span class="text-xs font-semibold text-quaternary uppercase tracking-wider">
              Technologies
            </span>
          </div>

          <div role="list" class="flex flex-wrap gap-1.5">
            {experience.tags.map((tag) => (
              <span role="listitem" class="cheep " tabindex="0" title={tag}>
                {tag}
              </span>
            ))}
          </div>
        </div>
      )
    }
  </div>
</article>
