---
interface Props {
  experience: {
    id?: string;
    title: string;
    period?: string;
    bullets?: string[];
    current?: boolean;
  };
}
const { experience } = Astro.props as Props;
---

<div class="flex flex-row items-start gap-6 relative pl-12">
  <div
    class={`timeline-marker ${experience.current ? "timeline-marker--current" : ""}`}
  >
  </div>

  <div class="surface-card-sm">
    <div
      class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2 mb-3"
    >
      <h3 class="text-xl font-bold font-display text-gray-900 dark:text-white">
        {experience.title}
      </h3>
      <span
        class="text-sm font-medium font-mono text-gray-500 dark:text-gray-400"
      >
        {experience.period}
      </span>
    </div>

    <ul class="space-y-2 text-gray-600 dark:text-gray-300 text-sm">
      {
        experience.bullets?.map((b) => (
          <li class="flex items-start">
            <span class="mr-2 mt-1">•</span>
            <span>{b}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
