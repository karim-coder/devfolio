---
// Header component
---

<header
  class="sticky top-0 z-50 backdrop-blur-xl py-4 px-6 md:px-8"
  style="background-color: var(--color-header-bg); border-bottom: 1px solid var(--color-header-border); box-shadow: 0 1px 0 var(--color-backdrop-strong);"
>
  <div class="max-w-7xl mx-auto flex justify-between items-center">
    <a
      href="#top"
      class="text-2xl md:text-3xl font-bold font-heading text-primary tracking-tight hover:opacity-70 transition-all duration-300"
      >KARIM</a
    >
    <nav class="flex items-center gap-6 md:gap-10">
      <a
        href="#work"
        class="font-medium text-sm md:text-base text-tertiary hover:text-primary relative group transition-colors duration-200"
      >
        Work
        <span
          class="absolute -bottom-1 left-0 w-0 h-0.5 transition-all duration-300 group-hover:w-full"
          style="background: linear-gradient(to right, var(--color-text-primary), var(--color-text-secondary));"
        ></span>
      </a>
      <a
        href="#about"
        class="font-medium text-sm md:text-base text-tertiary hover:text-primary relative group transition-colors duration-200"
      >
        About
        <span
          class="absolute -bottom-1 left-0 w-0 h-0.5 transition-all duration-300 group-hover:w-full"
          style="background: linear-gradient(to right, var(--color-text-primary), var(--color-text-secondary));"
        ></span>
      </a>
      <a
        href="#contact"
        class="font-medium text-sm md:text-base text-tertiary hover:text-primary relative group transition-colors duration-200"
      >
        Contact
        <span
          class="absolute -bottom-1 left-0 w-0 h-0.5 transition-all duration-300 group-hover:w-full"
          style="background: linear-gradient(to right, var(--color-text-primary), var(--color-text-secondary));"
        ></span>
      </a>
      <button
        id="theme-toggle"
        class="p-2.5 rounded-full transition-all duration-200 hover:scale-110 active:scale-95"
        style="background-color: transparent;"
        aria-label="Toggle theme"
      >
        <svg
          id="theme-icon-light"
          class="w-5 h-5 text-primary dark:hidden transition-transform duration-200"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
        <svg
          id="theme-icon-dark"
          class="w-5 h-5 text-primary hidden dark:block transition-transform duration-200"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  #theme-toggle:hover {
    background-color: var(--color-chip-bg) !important;
  }
</style>

<script>
  // Theme toggle functionality
  const htmlEl = document.documentElement;
  const themeToggleBtn = document.getElementById(
    "theme-toggle"
  ) as HTMLButtonElement | null;
  const themeIconLight = document.getElementById(
    "theme-icon-light"
  ) as HTMLElement | null;
  const themeIconDark = document.getElementById(
    "theme-icon-dark"
  ) as HTMLElement | null;

  // Get theme from localStorage or system preference
  const savedTheme = localStorage.getItem("theme");
  const systemPrefersDark = window.matchMedia(
    "(prefers-color-scheme: dark)"
  ).matches;

  // Set initial theme
  if (savedTheme === "dark" || (!savedTheme && systemPrefersDark)) {
    htmlEl.classList.add("dark");
    updateThemeIcons(true);
  } else {
    htmlEl.classList.remove("dark");
    updateThemeIcons(false);
  }

  // Toggle theme on button click
  if (themeToggleBtn) {
    themeToggleBtn.addEventListener("click", () => {
      const isDarkMode = htmlEl.classList.toggle("dark");
      localStorage.setItem("theme", isDarkMode ? "dark" : "light");
      updateThemeIcons(isDarkMode);
    });
  }

  // Update icons based on current theme
  function updateThemeIcons(isDarkMode: boolean) {
    if (themeIconLight && themeIconDark) {
      if (isDarkMode) {
        themeIconLight.classList.add("hidden");
        themeIconDark.classList.remove("hidden");
      } else {
        themeIconLight.classList.remove("hidden");
        themeIconDark.classList.add("hidden");
      }
    }
  }

  // Listen for system theme changes
  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", (e) => {
      if (!localStorage.getItem("theme")) {
        const isDarkMode = e.matches;
        htmlEl.classList.toggle("dark", isDarkMode);
        updateThemeIcons(isDarkMode);
      }
    });
</script>
