---
interface Props {
  project: {
    id?: string;
    title: string;
    category?: string;
    year?: string | number;
    description?: string;
    tags?: string[];
    href?: string;
  };
}
const { project } = Astro.props as Props;
const href = project.href ?? "#";
const isExternalLink = /^https?:\/\//i.test(href);
const target = isExternalLink ? "_blank" : undefined;
const rel = isExternalLink ? "noopener noreferrer" : undefined;
const metaSegments = [project.category, project.year?.toString()].filter(
  Boolean
);
const meta = metaSegments.join(" • ");
---

<a
  href={href}
  target={target}
  rel={rel}
  class="project-card surface-card rounded-xl p-4 md:p-6 flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6 group focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-border-strong)]"
  aria-label={`View ${project.title} project details`}
>
  <span
    class="thumbnail flex-shrink-0 rounded-lg flex items-center justify-center"
    role="presentation"
    aria-hidden="true"
  >
    <svg
      class="w-8 h-8 text-quaternary"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <rect
        width="16"
        height="16"
        x="4"
        y="4"
        rx="3"
        stroke="currentColor"
        stroke-width="1.5"
        opacity="0.12"></rect>
      <path
        d="M8 12h8M8 9h8M8 15h5"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>

  <div class="flex-1 min-w-0">
    {
      meta && (
        <div class="flex items-center gap-2 text-xs uppercase tracking-[0.3em] text-quaternary">
          <span>{meta}</span>
        </div>
      )
    }

    <div class="flex items-center gap-2 mt-2">
      <h3 class="text-xl font-bold font-display text-primary leading-tight">
        {project.title}
      </h3>
      <svg
        class="arrow-icon w-4 h-4 text-tertiary opacity-0 transition-all flex-shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7"></path>
      </svg>
    </div>

    {
      project.description && (
        <p class="mt-2 text-sm text-secondary leading-relaxed line-clamp-2">
          {project.description}
        </p>
      )
    }

    {
      project.tags && project.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {project.tags.map((tag) => (
            <span class="cheep">{tag}</span>
          ))}
        </div>
      )
    }
  </div>
</a>
