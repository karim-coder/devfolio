---
interface Props {
  project: {
    id?: string;
    title: string;
    category?: string;
    year?: string | number;
    description?: string;
    tags?: string[];
    href?: string;
    thumbnail?: string;
  };
}
const { project } = Astro.props as Props;
const href = project.href ?? "#";
const isExternalLink = /^https?:\/\//i.test(href);
const target = isExternalLink ? "_blank" : undefined;
const rel = isExternalLink ? "noopener noreferrer" : undefined;
const metaSegments = [project.category, project.year?.toString()].filter(
  Boolean
);
const meta = metaSegments.join(" • ");
---

<a
  href={href}
  target={target}
  rel={rel}
  class="project-card surface-card rounded-xl p-4 md:p-6 flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6 group focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-border-strong)]"
  aria-label={`View ${project.title} project details`}
>
  <!-- Mobile: Thumbnail + Title in row -->
  <div class="w-full flex sm:hidden items-start gap-3">
    {
      project.thumbnail ? (
        <img
          src={project.thumbnail}
          alt={`${project.title} thumbnail`}
          loading="lazy"
          decoding="async"
          class="thumbnail-mobile flex-shrink-0 rounded-lg flex items-center justify-center overflow-hidden w-20 h-20 object-cover"
        />
      ) : (
        <span
          class="thumbnail-mobile flex-shrink-0 rounded-lg flex items-center justify-center overflow-hidden"
          role="presentation"
          aria-hidden="true"
        >
          <svg
            class="w-full h-full"
            viewBox="0 0 100 100"
            fill="none"
            aria-hidden="true"
          >
            <defs>
              <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop
                  offset="0%"
                  style="stop-color:rgba(99, 102, 241, 0.15);stop-opacity:1"
                />
                <stop
                  offset="100%"
                  style="stop-color:rgba(168, 85, 247, 0.15);stop-opacity:1"
                />
              </linearGradient>
              <linearGradient id="grad2" x1="0%" y1="100%" x2="100%" y2="0%">
                <stop
                  offset="0%"
                  style="stop-color:rgba(59, 130, 246, 0.2);stop-opacity:1"
                />
                <stop
                  offset="100%"
                  style="stop-color:rgba(147, 51, 234, 0.2);stop-opacity:1"
                />
              </linearGradient>
            </defs>
            <rect width="100" height="100" fill="url(#grad1)" />
            <circle cx="25" cy="25" r="15" fill="url(#grad2)" opacity="0.6" />
            <circle cx="75" cy="75" r="20" fill="url(#grad2)" opacity="0.4" />
            <path
              d="M 20 50 Q 50 30 80 50 T 20 50"
              stroke="rgba(99, 102, 241, 0.3)"
              stroke-width="2"
              fill="none"
            />
            <rect
              x="35"
              y="35"
              width="30"
              height="30"
              rx="4"
              fill="rgba(168, 85, 247, 0.15)"
              stroke="rgba(168, 85, 247, 0.3)"
              stroke-width="1.5"
            />
            <circle cx="50" cy="50" r="8" fill="rgba(99, 102, 241, 0.4)" />
          </svg>
        </span>
      )
    }
    <div class="flex-1 min-w-0">
      {
        meta && (
          <div class="flex items-center gap-2 text-xs uppercase tracking-[0.3em] text-quaternary mb-1">
            <span>{meta}</span>
          </div>
        )
      }
      <div class="flex items-center gap-2">
        <h3 class="text-base font-bold font-display text-primary leading-tight">
          {project.title}
        </h3>
        <svg
          class="arrow-icon w-3.5 h-3.5 text-tertiary opacity-0 transition-all flex-shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
      </div>
    </div>
  </div>

  <!-- Desktop: Original thumbnail (hidden on mobile) -->
  {
    project.thumbnail ? (
      <img
        src={project.thumbnail}
        alt={`${project.title} thumbnail`}
        loading="lazy"
        decoding="async"
        class="thumbnail hidden sm:flex flex-shrink-0 rounded-lg items-center justify-center overflow-hidden w-24 h-24 object-cover"
      />
    ) : (
      <span
        class="thumbnail hidden sm:flex flex-shrink-0 rounded-lg items-center justify-center overflow-hidden"
        role="presentation"
        aria-hidden="true"
      >
        <svg
          class="w-full h-full"
          viewBox="0 0 100 100"
          fill="none"
          aria-hidden="true"
        >
          <defs>
            <linearGradient
              id="grad1-desktop"
              x1="0%"
              y1="0%"
              x2="100%"
              y2="100%"
            >
              <stop
                offset="0%"
                style="stop-color:rgba(99, 102, 241, 0.15);stop-opacity:1"
              />
              <stop
                offset="100%"
                style="stop-color:rgba(168, 85, 247, 0.15);stop-opacity:1"
              />
            </linearGradient>
            <linearGradient
              id="grad2-desktop"
              x1="0%"
              y1="100%"
              x2="100%"
              y2="0%"
            >
              <stop
                offset="0%"
                style="stop-color:rgba(59, 130, 246, 0.2);stop-opacity:1"
              />
              <stop
                offset="100%"
                style="stop-color:rgba(147, 51, 234, 0.2);stop-opacity:1"
              />
            </linearGradient>
          </defs>
          <rect width="100" height="100" fill="url(#grad1-desktop)" />
          <circle
            cx="25"
            cy="25"
            r="15"
            fill="url(#grad2-desktop)"
            opacity="0.6"
          />
          <circle
            cx="75"
            cy="75"
            r="20"
            fill="url(#grad2-desktop)"
            opacity="0.4"
          />
          <path
            d="M 20 50 Q 50 30 80 50 T 20 50"
            stroke="rgba(99, 102, 241, 0.3)"
            stroke-width="2"
            fill="none"
          />
          <rect
            x="35"
            y="35"
            width="30"
            height="30"
            rx="4"
            fill="rgba(168, 85, 247, 0.15)"
            stroke="rgba(168, 85, 247, 0.3)"
            stroke-width="1.5"
          />
          <circle cx="50" cy="50" r="8" fill="rgba(99, 102, 241, 0.4)" />
        </svg>
      </span>
    )
  }

  <!-- Content section -->
  <div class="flex-1 min-w-0 w-full">
    <!-- Desktop: Meta + Title (hidden on mobile) -->
    <div class="hidden sm:block">
      {
        meta && (
          <div class="flex items-center gap-2 text-xs uppercase tracking-[0.3em] text-quaternary">
            <span>{meta}</span>
          </div>
        )
      }
      <div class="flex items-center gap-2 mt-2">
        <h3 class="text-xl font-bold font-display text-primary leading-tight">
          {project.title}
        </h3>
        <svg
          class="arrow-icon w-4 h-4 text-tertiary opacity-0 transition-all flex-shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
      </div>
    </div>

    <!-- Description (all screens) -->
    {
      project.description && (
        <p class="mt-2 text-sm text-secondary leading-relaxed ">
          {project.description}
        </p>
      )
    }

    <!-- Tags (all screens) -->
    {
      project.tags && project.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {project.tags.map((tag) => (
            <span class="cheep">{tag}</span>
          ))}
        </div>
      )
    }
  </div>
</a>
