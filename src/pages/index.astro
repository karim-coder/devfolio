            <div class="flex flex-wrap gap-2">
              <span
                class="surface-chip px-3 py-1 rounded-lg text-gray-800 dark:text-neutral-100 text-sm font-medium font-mono"
                >React.js</span
              >
              <span
                class="surface-chip px-3 py-1 rounded-lg text-gray-800 dark:text-neutral-100 text-sm font-medium font-mono"
