---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-0 pb-16 font-sans">
    <header
      class="sticky top-0 z-50 bg-white/85 dark:bg-neutral-900/80 backdrop-blur-md border-b border-gray-200 dark:border-neutral-700 py-3"
    >
      <div class="flex justify-between items-center">
        <a
          href="#top"
          class="text-2xl font-bold font-heading text-gray-900 dark:text-white tracking-tight hover:opacity-80 transition-opacity"
          >KARIM</a
        >
        <nav class="flex items-center gap-8">
          <a
            href="#work"
            class="font-medium text-gray-700 dark:text-neutral-300 hover:text-gray-900 dark:hover:text-white relative group"
          >
            Work
            <span
              class="absolute -bottom-1 left-0 w-0 h-0.5 bg-gray-900 dark:bg-white transition-all group-hover:w-full"
            ></span>
          </a>
          <a
            href="#about"
            class="font-medium text-gray-700 dark:text-neutral-300 hover:text-gray-900 dark:hover:text-white relative group"
          >
            About
            <span
              class="absolute -bottom-1 left-0 w-0 h-0.5 bg-gray-900 dark:bg-white transition-all group-hover:w-full"
            ></span>
          </a>
          <a
            href="#contact"
            class="font-medium text-gray-700 dark:text-neutral-300 hover:text-gray-900 dark:hover:text-white relative group"
          >
            Contact
            <span
              class="absolute -bottom-1 left-0 w-0 h-0.5 bg-gray-900 dark:bg-white transition-all group-hover:w-full"
            ></span>
          </a>
          <button
            id="theme-toggle"
            class="p-2 rounded-full hover:bg-gray-100 dark:hover:bg-neutral-700 transition-colors"
            aria-label="Toggle theme"
          >
            <svg
              id="theme-icon-light"
              class="w-5 h-5 text-gray-900 dark:hidden"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
              ></path>
            </svg>
            <svg
              id="theme-icon-dark"
              class="w-5 h-5 text-white hidden dark:block"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
              ></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <section id="top" class="py-12 md:py-16">
      <div class="w-full">
        <div class="space-y-6">
          <h1
            class="text-4xl md:text-5xl font-bold font-display tracking-tight text-gray-900 dark:text-white leading-tight"
          >
            Karim Amiri
          </h1>
          <p
            class="text-sm uppercase tracking-[0.35em] text-gray-600 dark:text-neutral-400"
          >
            Software Engineer
          </p>
          <p
            class="text-xl text-gray-700 dark:text-neutral-200 leading-relaxed max-w-5xl"
          >
            Building scalable web and mobile applications with 4+ years of
            experience across fintech, AI, and healthcare domains. Specializing
            in React.js, Node.js, Flutter, and React Native to deliver
            exceptional digital experiences.
          </p>
          <ul
            class="space-y-3 text-sm text-gray-700 dark:text-neutral-200 max-w-5xl"
          >
            <li class="flex gap-3">
              <span
                class="mt-1 h-1.5 w-1.5 rounded-full bg-gray-500 dark:bg-neutral-600"
              ></span>
              <span
                >Partnering with founders to translate product vision into
                roadmaps and release plans.</span
              >
            </li>
            <li class="flex gap-3">
              <span
                class="mt-1 h-1.5 w-1.5 rounded-full bg-gray-500 dark:bg-neutral-600"
              ></span>
              <span
                >Architecting resilient systems with a calm, minimalist
                aesthetic and measurable performance.</span
              >
            </li>
          </ul>
          <div class="flex flex-wrap gap-4 pt-2">
            <a
              href="https://github.com/karim-coder"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-5 py-3 bg-gray-900 hover:bg-gray-800 dark:bg-white dark:hover:bg-neutral-100 border border-transparent rounded-xl font-medium text-white dark:text-black shadow-md hover:shadow-lg transition-all duration-300 group"
            >
              <svg
                class="w-5 h-5 mr-2"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.65.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                  clip-rule="evenodd"></path>
              </svg>
              GitHub
            </a>
            <a
              href="mailto:ab.amiri484@gmail.com"
              class="inline-flex items-center justify-center px-5 py-3 bg-white dark:bg-neutral-800/80 border border-gray-300 dark:border-neutral-600 hover:border-gray-400 dark:hover:border-neutral-500 rounded-xl font-medium text-gray-900 dark:text-white shadow-sm hover:shadow transition-all duration-300 group"
            >
              <svg
                class="w-5 h-5 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
              Connect
            </a>
          </div>
        </div>
      </div>
    </section>

    <section
      id="work"
      class="py-10 border-t border-gray-200 dark:border-neutral-800"
    >
      <div class="mb-8 md:mb-10">
        <span
          class="inline-block px-3 py-1 bg-gray-100 dark:bg-black text-gray-700 dark:text-neutral-200 rounded-full text-sm font-medium font-mono mb-3"
          >Portfolio</span
        >
        <h2
          class="text-3xl font-bold font-display text-gray-900 dark:text-white"
        >
          Selected Projects
        </h2>
        <p class="mt-3 text-sm text-gray-700 dark:text-neutral-300 max-w-2xl">
          A snapshot of recent collaborations across finance, healthcare, and
          learning — grounded in clarity, performance, and trust.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <article
          class="surface-card group relative overflow-hidden rounded-3xl border border-gray-200 dark:border-neutral-800 p-6 md:p-8 shadow-[0_18px_42px_rgba(15,15,15,0.08)] dark:shadow-[0_26px_60px_rgba(0,0,0,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:shadow-[0_28px_70px_rgba(15,15,15,0.12)] dark:hover:shadow-[0_32px_80px_rgba(0,0,0,0.45)]"
        >
          <div
            class="flex items-center justify-between text-xs uppercase tracking-[0.3em] text-gray-600 dark:text-neutral-400"
          >
            <span>Fintech</span>
            <span>2024</span>
          </div>
          <h3
            class="mt-4 text-2xl font-bold font-display text-gray-900 dark:text-white"
          >
            CryptoFlow
          </h3>
          <p
            class="mt-3 text-sm text-gray-700 dark:text-neutral-200 leading-relaxed"
          >
            Real-time trading platform featuring WebSocket infrastructure, risk
            analytics, and compliance workflows for regulated markets handling
            10K+ concurrent connections.
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            <span
              class="surface-chip px-3 py-1 rounded-full border border-gray-300 dark:border-neutral-700 text-xs font-medium text-gray-900 dark:text-neutral-100"
              >React</span
            >
            <span
              class="surface-chip px-3 py-1 rounded-full border border-gray-300 dark:border-neutral-700 text-xs font-medium text-gray-900 dark:text-neutral-100"
              >Node.js</span
            >
            <span
              class="surface-chip px-3 py-1 rounded-full border border-gray-300 dark:border-neutral-700 text-xs font-medium text-gray-900 dark:text-neutral-100"
              >PostgreSQL</span
            >
            <span
              class="surface-chip px-3 py-1 rounded-full border border-gray-300 dark:border-neutral-700 text-xs font-medium text-gray-900 dark:text-neutral-100"
              >WebSocket</span
            >
          </div>
          <div
            class="mt-6 flex items-center justify-between border-t border-gray-200 dark:border-neutral-800 pt-4"
          >
            <span
              class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.3em] text-gray-600 dark:text-neutral-400"
              >Featured</span
            >
            <span
              class="inline-flex items-center gap-2 text-sm font-medium text-gray-900 dark:text-white"
            >
              Case study
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M7 17L17 7M7 7h10v10"></path>
              </svg>
            </span>
          </div>
        </article>

        <article
          class="surface-card group relative overflow-hidden rounded-3xl border border-gray-200 dark:border-neutral-800 p-6 md:p-8 shadow-[0_18px_42px_rgba(15,15,15,0.08)] dark:shadow-[0_26px_60px_rgba(0,0,0,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:shadow-[0_28px_70px_rgba(15,15,15,0.12)] dark:hover:shadow-[0_32px_80px_rgba(0,0,0,0.45)]"
