---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import Header from "../components/Header.astro";
import ProjectCard from "../components/ProjectCard.astro";
import projects from "../data/projects.json";
import ExperienceCard from "../components/ExperienceCard.astro";
import experiences from "../data/experiences.json";
import SkillCard from "../components/SkillCard.astro";
import skills from "../data/skills.json";
import SocialCard from "../components/SocialCard.astro";
import socials from "../data/socials.json";
---

<Layout>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-0 pb-16 font-sans">
    <Header />

    <section id="top" class="py-12 md:py-16">
      <div class="max-w-6xl mx-auto w-full">
        <div class="space-y-6">
          <h1
            class="text-4xl md:text-5xl font-bold font-display tracking-tight text-gray-900 dark:text-white leading-tight"
          >
            Karim Amiri
          </h1>
          <p
            class="text-sm uppercase tracking-[0.35em] text-gray-500 dark:text-gray-400"
          >
            Software Engineer
          </p>
          <p class="text-xl text-gray-600 dark:text-gray-300 leading-relaxed">
            Building scalable web and mobile applications with 4+ years of
            experience across fintech, AI, and healthcare domains. Specializing
            in React.js, Node.js, Flutter, and React Native to deliver
            exceptional digital experiences.
          </p>
          <div class="flex flex-wrap gap-4 pt-2">
            {/* GitHub Button */}
            <a
              href="https://github.com/karim-coder"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-5 py-2 github-btn rounded-xl font-medium shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5 group"
            >
              <svg
                class="w-5 h-5 mr-2 transform group-hover:scale-110 transition-transform duration-300"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.65.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-">GitHub</span>
            </a>

            {/* Connect Button */}
            <a
              href="mailto:ab.amiri484@gmail.com"
              class="inline-flex items-center justify-center px-5 py-2.5 bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-[var(--color-border-strong)] rounded-xl font-medium text-[var(--color-text-primary)] shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5 group"
            >
              <svg
                class="w-5 h-5 mr-2 transform group-hover:scale-110 transition-transform duration-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
              <span>Connect</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="work" class="py-10 section-divider">
      <div class="mb-8 md:mb-10">
        <span class="cheep-lg mb-3">Portfolio</span>
        <h2
          class="text-3xl font-bold font-display text-gray-900 dark:text-white"
        >
          Selected Projects
        </h2>
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-400 max-w-2xl">
          A snapshot of recent collaborations across finance, healthcare, and
          learning — grounded in clarity, performance, and trust.
        </p>
      </div>

      <div class="space-y-4">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section id="about" class="py-10 section-divider">
      <div class="mb-8 md:mb-10">
        <span class="cheep-lg mb-3">Background</span>
        <h2
          class="text-3xl font-bold font-display text-gray-900 dark:text-white"
        >
          Professional Journey
        </h2>
      </div>

      <div class="relative">
        <!-- <div
          class="absolute left-5 top-0 bottom-0 w-px section-vertical-divider"
        >
        </div> -->

        <div class="space-y-0 md:space-y-0">
          {experiences.map((exp) => <ExperienceCard experience={exp} />)}
        </div>
      </div>

      <div class="mt-14">
        <div class="mb-8">
          <span class="cheep-lg mb-3">Technical Skills</span>
          <h2
            class="text-3xl font-bold font-display text-gray-900 dark:text-white"
          >
            My Expertise
          </h2>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {skills.map((skill) => <SkillCard skill={skill} />)}
        </div>
      </div>
    </section>

    <section id="contact" class="py-12 section-divider">
      <div class="max-w-6xl mx-auto">
        <div class="mb-10">
          <span class="cheep-lg mb-3">Get in touch</span>
          <h2
            class="text-3xl font-bold font-display text-gray-900 dark:text-white"
          >
            Let's build something meaningful together
          </h2>
          <p class="text-gray-600 dark:text-gray-300 mt-3 max-w-2xl">
            Available for freelance projects and full-time opportunities. Expect
            a response within 24 hours.
          </p>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          {socials.map((social) => <SocialCard social={social} />)}
        </div>
      </div>
    </section>

    <footer class="pt-8 border-t section-divider">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
          class="flex flex-col md:flex-row items-center justify-between gap-2"
        >
          <p
            class="text-sm text-gray-500 dark:text-gray-400 text-center md:text-left"
          >
            © {new Date().getFullYear()} Karim Amiri. All rights reserved.
          </p>
          <p
            class="text-sm text-gray-500 dark:text-gray-400 text-center md:text-right"
          >
            Built with Astro · Tailwind CSS
          </p>
        </div>
      </div>
    </footer>
  </main>

  <script>
    // Smooth scrolling for anchor links
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener(
        "click",
        function (this: HTMLAnchorElement, e: Event) {
          e.preventDefault();
          const targetId = this.getAttribute("href");
          if (!targetId || targetId === "#") return;

          const targetElement = document.querySelector(targetId) as HTMLElement;
          if (targetElement) {
            window.scrollTo({
              top: targetElement.offsetTop - 72,
              behavior: "smooth",
            });
          }
        }
      );
    });
  </script>
</Layout>
